# Port the API + Socket.IO server listens on
PORT=3001
# Allowed browser origin(s) for CORS, comma-separated (your Vercel URL in production)
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional TURN relay for movie nights' "stream from my device", needed when viewers are on
# mobile data or strict networks. Configure ONE provider; the server hands out short-lived
# credentials at /api/ice, so these secrets never reach the website.
# Cloudflare Realtime TURN (dash.cloudflare.com → Realtime → TURN Server → Create):
# TURN_CLOUDFLARE_KEY_ID=
# TURN_CLOUDFLARE_API_TOKEN=
# Metered (metered.ca → TURN Server → app domain + API key):
# TURN_METERED_DOMAIN=yourapp.metered.live
# TURN_METERED_API_KEY=
# Your own coturn:
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=
# TURN_CREDENTIAL=
