# URL of the Relax Together server (Render/Railway URL in production).
# In development this defaults to http://<current-host>:3001 when unset.
VITE_SERVER_URL=http://localhost:3001

# Optional TURN relay for movie nights' "stream from my device" on networks that block
# peer-to-peer connections (comma-separate several URLs).
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
